DATABASE_URL="postgresql://user:password@host:5432/dbname"

AUTH_SECRET="generate with: npx auth secret"

# Optional: enables "Sign in with Gmail" on /login and /register.
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# with authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev).
# Leave unset to keep credentials-only login working normally.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
